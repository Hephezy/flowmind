# API: copy this file to apps/api/.env (Node loads it via --env-file)
DATABASE_URL=postgresql://flowmind:flowmind_local_only@localhost:5432/flowmind
REDIS_URL=redis://localhost:6379
PORT=4000
NODE_ENV=development
# Generate with: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# For same-site custom domains use false; cross-site production APIs require true + HTTPS
COOKIE_CROSS_SITE=false
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
EXTRACTION_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Optional Supabase storage. Leave blank for a local mounted data volume.
STORAGE_URL=
STORAGE_KEY=
STORAGE_BUCKET=meeting-recordings
LOCAL_STORAGE_PATH=./data
RESEND_API_KEY=
EMAIL_FROM=FlowMind <meetings@your-verified-domain.com>
# HTTPS callback destination /api/integrations/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Explicit destination hosts for webhooks and Zoom recording downloads
EGRESS_ALLOWED_HOSTS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
# WEB: copy the following to apps/web/.env.local; blank API URL selects the demo
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Optional quotas, only configured limits are enforced; example structure:
# PLAN_LIMITS_JSON={"starter":{"meetings":5,"members":3,"storageBytes":1073741824},"pro":{"meetings":100},"team":{}}
PLAN_LIMITS_JSON={}
